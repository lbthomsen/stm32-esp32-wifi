CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# SPI pins (esp-hosted defaults for ESP32-S3, same as the 2.x build)
CONFIG_EH_TRANSPORT_CP_SPI_HSPI_GPIO_MOSI=11
CONFIG_EH_TRANSPORT_CP_SPI_HSPI_GPIO_MISO=13
CONFIG_EH_TRANSPORT_CP_SPI_HSPI_GPIO_CLK=12
CONFIG_EH_TRANSPORT_CP_SPI_HSPI_GPIO_CS=10
CONFIG_EH_TRANSPORT_CP_SPI_GPIO_HANDSHAKE=17
CONFIG_EH_TRANSPORT_CP_SPI_GPIO_DATA_READY=4
CONFIG_EH_TRANSPORT_CP_SPI_GPIO_RESET=-1
